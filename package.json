{
  "name": "ua-tts-text",
  "version": "0.11.0",
  "description": "Готує український текст до озвучки: числа, роки, скорочення, наголоси під конкретний рушій",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lexicon",
    "skills",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build",
    "eval": "node scripts/eval.mjs"
  },
  "keywords": [
    "ukrainian",
    "tts",
    "text-normalization",
    "stress",
    "наголос",
    "озвучка"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Mykyta Stelmashenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MykytaStel/ua-tts-text.git"
  },
  "bugs": {
    "url": "https://github.com/MykytaStel/ua-tts-text/issues"
  },
  "homepage": "https://github.com/MykytaStel/ua-tts-text#readme",
  "bin": {
    "ua-tts-text": "./scripts/cli.mjs",
    "ua-tts-text-fetch-dict": "./scripts/fetch-dict.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
