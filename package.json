{
  "name": "ua-tts-text",
  "version": "0.17.0",
  "description": "Готує український текст до озвучки: числа, роки, скорочення, наголоси під конкретний рушій",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "lexicon",
    "skills",
    "scripts/cli.mjs",
    "scripts/blind-audio.mjs",
    "scripts/fetch-dict.mjs",
    "scripts/build-dict.mjs",
    "scripts/dictionary-source.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run && node --test scripts/audit-review.check.mjs scripts/evaluation.check.mjs scripts/dictionary.check.mjs scripts/blind-audio.check.mjs && node scripts/normalization-eval.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && node scripts/package-smoke.mjs",
    "prepack": "pnpm build",
    "eval": "node scripts/eval.mjs",
    "eval:normalization": "node scripts/normalization-eval.mjs",
    "eval:blind": "node scripts/blind-audio.mjs"
  },
  "keywords": [
    "ukrainian",
    "tts",
    "text-normalization",
    "stress",
    "наголос",
    "озвучка"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Mykyta Stelmashenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MykytaStel/ua-tts-text.git"
  },
  "bugs": {
    "url": "https://github.com/MykytaStel/ua-tts-text/issues"
  },
  "homepage": "https://github.com/MykytaStel/ua-tts-text#readme",
  "bin": {
    "ua-tts-text": "scripts/cli.mjs",
    "ua-tts-text-fetch-dict": "scripts/fetch-dict.mjs",
    "ua-tts-text-blind-audio": "scripts/blind-audio.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
